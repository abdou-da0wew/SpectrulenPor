# SpectruLenPor firmware sdkconfig
#
# Build settings for AI-Thinker ESP32-CAM (ESP32-S, dual core, 4MB flash,
# PSRAM for camera frame buffers).
#
# Edit these on hpc2 before `idf.py build`:
#   idf.py menuconfig

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_BAUDRATE_115200=y

CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_REV_MIN_1=y

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=1
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3

# PSRAM for camera frame buffers (AI-Thinker ESP32-CAM has 4MB PSRAM)
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_ESP32_SPIRAM_MODE_OCT=y
CONFIG_ESP32_SPIRAM_SPEED_40M=y
CONFIG_ESP32_SPIRAM_SIZE_4MB=y

# BLE (NimBLE) for telemetry + commands + WiFi config
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# WiFi STA + mDNS for UDP video discovery
CONFIG_ESP_WIFI_SOFTAP_ENABLE=n
CONFIG_ESP_WIFI_STA_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_NUM=32
CONFIG_ESP_WIFI_NVS_ENABLE=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

CONFIG_MDNS_ENABLED=y

# FreeRTOS dual core
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=5
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
